# ---------------------------------------------------------------
# Copia este archivo como .env.local (nunca se sube a Git):
#   Copy-Item .env.example .env.local
# ---------------------------------------------------------------

# SOLO SERVIDOR (sin prefijo NEXT_PUBLIC_: nunca llegan al navegador)
# URL base de la API Laravel 12, incluido el prefijo /api
BASE_URL=http://127.0.0.1:8000/api
# Moneda de la tienda: debe coincidir con STRIPE_CURRENCY del backend
STORE_CURRENCY=USD

# PÚBLICA (llega al navegador; no es un secreto)
# URL pública de este frontend, para metadatos y redirecciones
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# No hace falta ninguna clave de Stripe en el frontend: la clave publicable
# la entrega la API junto con cada pago, y la clave secreta vive solo en Laravel.
