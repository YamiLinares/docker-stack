# =============================================================================
# docker-stack · Plantilla de configuración para Docker Compose
#
# 1. Copia este archivo:   Copy-Item .env.example .env      (PowerShell)
#                          cp .env.example .env             (Linux / macOS)
# 2. Reemplaza TODOS los valores marcados con "cambia-esto" y genera APP_KEY y
#    JWT_SECRET con los comandos del README.
# 3. Nunca subas .env a Git (ya está en .gitignore).
#
# Todos los valores de este archivo son ficticios.
# =============================================================================

# --- Puertos publicados en el equipo (solo en 127.0.0.1) ---------------------
# Cámbialos si ya están ocupados. Los puertos internos (3000, 8000, 3306) no cambian.
FRONTEND_PORT=3200          # Next.js → http://localhost:3200
BACKEND_PORT=8200           # Nginx + Laravel → http://localhost:8200/api

# --- MySQL --------------------------------------------------------------------
# Se aplican SOLO al crear el volumen por primera vez. Si cambias estas
# contraseñas después, MySQL seguirá usando las antiguas (ver README).
MYSQL_ROOT_PASSWORD=cambia-esto-root-ejemplo
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=cambia-esto-app-ejemplo

# --- Laravel: aplicación -------------------------------------------------------
APP_ENV=production
# En producción siempre false: con true, Laravel mostraría trazas de error.
APP_DEBUG=false
# Clave de cifrado de Laravel (formato base64:...). Genérala con el comando del README.
APP_KEY=
# URL pública de la API. Debe coincidir con BACKEND_PORT.
APP_URL=http://localhost:8200
# debug | info | warning | error
LOG_LEVEL=warning

# --- Laravel: conexión a la base de datos ------------------------------------
# DB_HOST es el nombre del servicio de MySQL en Docker Compose (no localhost).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
# Se toman de las variables de MySQL para no escribir las credenciales dos veces.
DB_DATABASE=${MYSQL_DATABASE}
DB_USERNAME=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}

# --- Laravel: autenticación JWT ----------------------------------------------
# Clave de firma de los tokens (64 caracteres aleatorios). Genérala con el README.
JWT_SECRET=

# --- Stripe (opcional, modo de pruebas) --------------------------------------
# Sin estas claves la tienda funciona (catálogo, cuentas, carrito, órdenes y
# panel de productos), pero el paso de pago con tarjeta muestra que no está configurado.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STORE_CURRENCY=USD

# --- Usuarios de demostración (solo en el primer arranque) -------------------
# Si dejas una contraseña vacía, se genera una aleatoria y se muestra una sola
# vez en:  docker compose logs migrate
SEED_ADMIN_EMAIL=admin@ecommerce.test
SEED_ADMIN_PASSWORD=cambia-esto-Admin2026
SEED_CUSTOMER_EMAIL=cliente@ecommerce.test
SEED_CUSTOMER_PASSWORD=cambia-esto-Cliente2026

# --- Solo con docker-compose.mysql-port.yml (acceso a MySQL desde el equipo) --
MYSQL_HOST_PORT=3307
